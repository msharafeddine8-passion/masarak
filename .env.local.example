# Copy this file to .env.local and fill in your values.

# ── Supabase (public — safe to expose to the browser) ───────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://cxctwvqqnpvoebpelkle.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# ── Supabase service role (SERVER-ONLY — never expose to the client!) ────────
# Used by API routes / cron jobs that must bypass RLS. From Settings → API.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE

# ── Site / app ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.masaraklb.com

# Comma-separated admin emails (gates /admin/* in middleware).
# Falls back to msharafeddine8@gmail.com if unset.
ADMIN_EMAILS=msharafeddine8@gmail.com

# Shared secret for Vercel Cron auth (Authorization: Bearer <CRON_SECRET>).
# Cron routes now fail closed if this is unset.
CRON_SECRET=PASTE_A_LONG_RANDOM_STRING

# ── Optional integrations ───────────────────────────────────────────────────
# Anthropic key for the AI CEO briefing (/api/admin/ai-briefing). Optional.
ANTHROPIC_API_KEY=

# Google Analytics measurement id (e.g. G-XXXXXXXXXX). Optional.
NEXT_PUBLIC_GA_ID=

# WhatsApp contact number for the floating button (digits only, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=
